#!/bin/sh
# First-boot: daily health cron + lock down notify secrets in UCI.
# Disable cron: sed -i '/istoreos-health/d' /etc/crontabs/root; /etc/init.d/cron reload

CRON_FILE=/etc/crontabs/root
LINE='17 4 * * * /usr/sbin/istoreos-health >>/var/log/istoreos-health.log 2>&1'
CFG=/etc/config/istoreos-health

[ -x /usr/sbin/istoreos-health ] || exit 0

# Secrets (tg_token, smtp_pass) live in this UCI file — not world-readable.
if [ -f "$CFG" ]; then
	chmod 600 "$CFG" 2>/dev/null || true
	chown root:root "$CFG" 2>/dev/null || true
fi

mkdir -p /etc/crontabs
touch "$CRON_FILE"
if ! grep -qF 'istoreos-health' "$CRON_FILE" 2>/dev/null; then
	echo "$LINE" >>"$CRON_FILE"
	[ -x /etc/init.d/cron ] && /etc/init.d/cron reload >/dev/null 2>&1 || true
fi
exit 0
