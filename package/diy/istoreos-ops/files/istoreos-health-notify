#!/bin/sh
# Telegram notify after istoreos-health. Secrets never go to logger/stdout.
# Transport: Telegram Bot API via curl.
# See docs/CUSTOM-TRIMMING.md §三十九.

LOGTAG=istoreos-health-notify
UCI_SEC=istoreos-health.notify

log() { logger -t "$LOGTAG" "$*"; }
say() { echo "$*"; }

uci_get() { uci -q get "$UCI_SEC.$1"; }

# Keep secrets out of world-readable mode (LuCI/uci may rewrite as 644).
harden_cfg() {
	[ -f /etc/config/istoreos-health ] || return 0
	chmod 600 /etc/config/istoreos-health 2>/dev/null || true
}
harden_cfg

usage() {
	cat <<USAGE
usage: istoreos-health-notify {after-health <rc> [report]|test-telegram}
USAGE
}

hostname_s() {
	uci -q get system.@system[0].hostname 2>/dev/null || cat /proc/sys/kernel/hostname 2>/dev/null || echo istoreos
}

mk_curl_cfg() {
	local f
	f=$(mktemp /tmp/istoreos-notify.XXXXXX) || return 1
	chmod 600 "$f" || { rm -f "$f"; return 1; }
	echo "$f"
}

send_telegram() {
	local text=$1 token chat cfg url ec
	token=$(uci_get tg_token)
	chat=$(uci_get tg_chat_id)
	[ -n "$token" ] && [ -n "$chat" ] || { say "telegram: skip (token/chat_id empty)"; return 1; }
	command -v curl >/dev/null 2>&1 || { say "telegram: curl missing"; return 1; }

	cfg=$(mk_curl_cfg) || return 1
	url="https://api.telegram.org/bot${token}/sendMessage"
	{
		echo "url = \"$url\""
		echo "silent"
		echo "show-error"
		echo "connect-timeout = 15"
		echo "max-time = 60"
	} >"$cfg"

	ec=0
	if curl -K "$cfg" -X POST \
		--data-urlencode "chat_id=${chat}" \
		--data-urlencode "text=${text}" \
		-o /tmp/istoreos-tg-resp.json >/dev/null 2>/tmp/istoreos-tg.err; then
		if jsonfilter -i /tmp/istoreos-tg-resp.json -e '@.ok' 2>/dev/null | grep -q true; then
			say "telegram: ok"
			log "telegram: ok"
			ec=0
		else
			say "telegram: api rejected (see device log, no secrets)"
			log "telegram: api rejected"
			ec=1
		fi
	else
		say "telegram: curl failed"
		log "telegram: curl failed"
		ec=1
	fi
	rm -f "$cfg" /tmp/istoreos-tg-resp.json /tmp/istoreos-tg.err
	return "$ec"
}

do_after_health() {
	local rc=${1:-1} report=${2:-/tmp/istoreos-health.report}
	local when enabled host subject body snippet

	enabled=$(uci_get enabled)
	[ "$enabled" = 1 ] || { say "notify: disabled"; return 0; }

	[ "$(uci_get telegram)" = 1 ] || { say "notify: telegram channel off"; return 0; }

	when=$(uci_get when); when=${when:-fail}
	case "$when" in
		always) ;;
		fail|*)
			[ "$rc" = 0 ] && { say "notify: skip (when=fail, health ok)"; return 0; }
			;;
	esac

	host=$(hostname_s)
	if [ "$rc" = 0 ]; then
		subject="[istoreos-health] OK on $host"
	else
		subject="[istoreos-health] FAIL on $host"
	fi
	snippet=$(head -c 3500 "$report" 2>/dev/null || echo "(no report)")
	body=$(printf '%s\nrc=%s\n\n%s\n' "$subject" "$rc" "$snippet")
	send_telegram "$body"
}

do_test_telegram() {
	local host body
	host=$(hostname_s)
	body="istoreos-health Telegram test from $host at $(date '+%Y-%m-%d %H:%M:%S %z')"
	if [ -z "$(uci_get tg_token)" ] || [ -z "$(uci_get tg_chat_id)" ]; then
		say "telegram: configure token and chat id first"
		return 1
	fi
	send_telegram "$body"
}

cmd=${1:-}
shift 2>/dev/null || true
case "$cmd" in
	after-health) do_after_health "$@" ;;
	test-telegram) do_test_telegram ;;
	""|-h|--help|help) usage; exit 0 ;;
	*) usage; exit 1 ;;
esac
