msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid "Health Check"
msgstr "健康巡检"

msgid "Daily health inspection (Tailscale / firewall / durable helper / DNS). Optional Telegram notify. Bot token is stored in /etc/config/istoreos-health (mode 600) and is never written to health logs."
msgstr "每日健康巡检（Tailscale / 防火墙 / 耐久 helper / DNS）。可选 Telegram 通知。Bot token 保存在 /etc/config/istoreos-health（权限 600），不会写入巡检日志。"

msgid "Notification"
msgstr "通知"

msgid "Enable notifications"
msgstr "启用通知"

msgid "When to notify"
msgstr "何时通知"

msgid "On failure only"
msgstr "仅失败时"

msgid "Always (OK and FAIL)"
msgstr "总是（成功与失败）"

msgid "Telegram"
msgstr "Telegram"

msgid "Bot token"
msgstr "Bot Token"

msgid "Chat ID"
msgstr "Chat ID"

msgid "Actions"
msgstr "操作"

msgid "Save settings above first. Test button does not print secrets."
msgstr "请先保存上方配置。测试按钮不会输出密钥。"

msgid "Test Telegram"
msgstr "测试 Telegram"

msgid "Run health now"
msgstr "立即巡检"
