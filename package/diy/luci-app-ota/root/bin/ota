#!/bin/sh
# OTA for this fork's GitHub Releases (NOT koolcenter / official iStoreOS).
# Repo default: xcy960815/istoreos  — override via uci ota.github.owner / ota.github.repo
# Flow: check → download (.img.gz) → sha256 verify → gunzip → /tmp/firmware.img
# Flash is always a separate LuCI confirm (never auto).

WRLOCK=/var/lock/ota_background.lock
STLOCK=/var/lock/ota_status.lock
STATE_DIR=/var/run/ota
IMG=/tmp/firmware.img
IMG_GZ=/tmp/firmware.img.gz
IMG_PART=/tmp/firmware.img.part
PROG=/tmp/firmware.img.progress
SUMFILE=/tmp/firmware.img.sha256sum
META=$STATE_DIR/release.meta
SHA256SUMS=$STATE_DIR/sha256sums

owner=$(uci -q get ota.github.owner 2>/dev/null); owner=${owner:-xcy960815}
repo=$(uci -q get ota.github.repo 2>/dev/null); repo=${repo:-istoreos}
# Prefer EFI combined image (J4125 / N100 GPT). Override with full basename if needed.
asset_suffix=$(uci -q get ota.github.asset_suffix 2>/dev/null)
asset_suffix=${asset_suffix:-squashfs-combined-efi.img.gz}

OTA_CURL_OPTS=""
action=${1:-}
shift 2>/dev/null || true

case $action in
	check|download)
		[ "$(uci -q get ota.network.ipv4)" = 1 ] && OTA_CURL_OPTS="--ipv4"
	;;
esac
# shellcheck disable=SC2086
alias fcurl="curl $OTA_CURL_OPTS -fsSL --connect-timeout 15 --max-time 600"

sha256() {
	sha256sum "$1" | cut -d' ' -f1
}

ota_init() {
	mkdir -p "$STATE_DIR" >/dev/null 2>&1 || true
}

# Current trimmed build id: prefer DISTRIB_REVISION when it looks like rNN (CI stamps VERSION_CODE).
current_tag() {
	local rev
	rev=$(grep 'DISTRIB_REVISION=' /etc/openwrt_release 2>/dev/null | sed -E "s/.*'(.+)'.*/\1/")
	case "$rev" in
		r[0-9]|r[0-9][0-9]|r[0-9][0-9][0-9]|r[0-9][0-9][0-9][0-9]|r[0-9][0-9][0-9][0-9][0-9])
			echo "$rev"; return 0
		;;
	esac
	if [ -f /etc/istoreos-trim-release ]; then
		tr -d ' \n' </etc/istoreos-trim-release
		return 0
	fi
	echo ""
}

tag_num() {
	echo "$1" | sed -E 's/^r([0-9]+).*/\1/'
}

# Resolve latest release into $META:
# TAG=r33
# ASSET=istoreos-...-squashfs-combined-efi.img.gz
# SHA256=...
# BROWSER_URL=https://github.com/.../download/...
# HTML_URL=https://github.com/.../releases/tag/r33
fetch_latest_meta() {
	local json tag asset sum sums_url browser html line name
	json=$STATE_DIR/release.json
	# GitHub API (jsonfilter is in seed)
	if ! fcurl -o "$json" \
		-H "Accept: application/vnd.github+json" \
		-H "User-Agent: istoreos-trim-ota" \
		"https://api.github.com/repos/${owner}/${repo}/releases/latest"; then
		echo "Failed to query GitHub API for ${owner}/${repo}" >&2
		return 255
	fi
	tag=$(jsonfilter -i "$json" -e '@.tag_name' 2>/dev/null)
	html=$(jsonfilter -i "$json" -e '@.html_url' 2>/dev/null)
	[ -n "$tag" ] || { echo "No tag_name in GitHub response" >&2; return 255; }

	# Prefer CI-uploaded ota.meta if present
	browser=$(jsonfilter -i "$json" -e "@.assets[@.name='ota.meta'].browser_download_url" 2>/dev/null)
	if [ -n "$browser" ]; then
		if fcurl -o "$META" "$browser"; then
			grep -q '^TAG=' "$META" && grep -q '^SHA256=' "$META" && grep -q '^ASSET=' "$META" && {
				echo "HTML_URL=$html" >>"$META"
				return 0
			}
		fi
	fi

	# Pick asset by suffix; get sha256sums asset
	asset=""
	sums_url=""
	# jsonfilter list of names
	for name in $(jsonfilter -i "$json" -e '@.assets[*].name' 2>/dev/null); do
		case "$name" in
			*"$asset_suffix")
				asset=$name
				browser=$(jsonfilter -i "$json" -e "@.assets[@.name='$name'].browser_download_url")
			;;
			sha256sums)
				sums_url=$(jsonfilter -i "$json" -e "@.assets[@.name='sha256sums'].browser_download_url")
			;;
		esac
	done
	[ -n "$asset" ] && [ -n "$browser" ] || {
		echo "No release asset matching *$asset_suffix" >&2
		return 255
	}
	[ -n "$sums_url" ] || { echo "Release has no sha256sums asset" >&2; return 255; }
	fcurl -o "$SHA256SUMS" "$sums_url" || { echo "Failed to download sha256sums" >&2; return 255; }
	# sha256sums: binary "<hash> *<file>" or text "<hash>  <file>"
	# Strip leading * from field 2 so both forms match (same bug class as CI r36).
	sum=$(awk -v f="$asset" '
		{
			name=$2
			sub(/^\*/, "", name)
			if (name == f) { print $1; exit }
		}
	' "$SHA256SUMS")
	[ -n "$sum" ] && [ "${#sum}" -ge 64 ] || {
		echo "SHA256 for $asset not found in sha256sums" >&2
		return 255
	}
	cat >"$META" <<EOF
TAG=$tag
ASSET=$asset
SHA256=$sum
BROWSER_URL=$browser
HTML_URL=$html
EOF
	return 0
}

meta_get() {
	grep "^$1=" "$META" 2>/dev/null | head -1 | cut -d= -f2-
}

prepare_check() {
	local latest=0
	local cur remote cur_n remote_n
	if find "$STATE_DIR/check.status" -mmin -5 2>/dev/null | grep -q .; then
		latest=$(cat "$STATE_DIR/check.status")
		return "$latest"
	fi
	fetch_latest_meta || return 255
	cur=$(current_tag)
	remote=$(meta_get TAG)
	: >"$STATE_DIR/ota.log"
	{
		echo "<pre>"
		echo "GitHub: ${owner}/${repo}"
		echo "Current: ${cur:-unknown}"
		echo "Latest:  $remote ($(meta_get ASSET))"
		echo "SHA256:  $(meta_get SHA256)"
		echo "</pre>"
		if [ -n "$(meta_get HTML_URL)" ]; then
			echo "<p><a href=\"$(meta_get HTML_URL)\" target=\"_blank\" rel=\"noopener\">Release notes</a></p>"
		fi
		echo "<p>Flash only after checksum OK. Confirm keep-settings on the next step — never auto-flash.</p>"
	} >>"$STATE_DIR/ota.log"

	if [ -n "$cur" ] && [ "$cur" = "$remote" ]; then
		latest=1
	elif [ -n "$cur" ]; then
		cur_n=$(tag_num "$cur")
		remote_n=$(tag_num "$remote")
		if [ -n "$cur_n" ] && [ -n "$remote_n" ] && [ "$cur_n" -ge "$remote_n" ] 2>/dev/null; then
			latest=1
		fi
	fi
	# Also emit koolcenter-shaped "latest" header lines for LuCI HTML (title uses first <pre> block from check)
	# Stock UI prepends sed of ota.latest; we put summary in ota.log already.
	printf '[%s](%s)\n\nSHA256: %s\n' "$(meta_get TAG)" "$(meta_get ASSET)" "$(meta_get SHA256)" >"$STATE_DIR/ota.latest"
	echo "$latest" >"$STATE_DIR/check.status"
	return "$latest"
}

# 0: newer found, 1: already latest, 2: download in progress, *: err
do_check() {
	local ret=0
	exec 200>$WRLOCK
	if flock -n 200; then
		prepare_check
		ret=$?
		flock -u 200 >/dev/null 2>&1
	elif [ -f "$PROG" -o -f "$SUMFILE" ]; then
		ret=2
	else
		echo "lock failed!" >&2
		return 255
	fi
	if [ "$ret" -eq 0 -o "$ret" -eq 2 ]; then
		echo "<pre>"
		sed -E '1 s/^\[.*\]\((.+)\)\s*$/\1/' "$STATE_DIR/ota.latest" 2>/dev/null
		echo "</pre>"
		echo "<br><h2>ChangeLog:</h2>"
	fi
	[ "$ret" -eq 0 -o "$ret" -eq 1 -o "$ret" -eq 2 ] && cat "$STATE_DIR/ota.log"
	return $ret
}

download() {
	local url sum name
	[ -f "$META" ] || { echo "do check first" >&2; return 254; }
	url=$(meta_get BROWSER_URL)
	sum=$(meta_get SHA256)
	name=$(meta_get ASSET)
	[ -n "$url" ] && [ -n "$sum" ] || { echo "incomplete meta" >&2; return 254; }

	exec 300>$STLOCK
	flock 300
	touch "$IMG_PART"
	echo >/tmp/firmware.img.progress
	rm -f "$SUMFILE" "$IMG" "$IMG_GZ"
	flock -u 300

	if [ -f "$IMG_GZ" ] && [ "$(sha256 "$IMG_GZ")" = "$sum" ]; then
		echo "Reusing verified $IMG_GZ" >>"$PROG"
	else
		echo "Downloading $name ..." >>"$PROG"
		exec 300>$STLOCK
		flock 300
		echo "#=#=#" >>"$PROG"
		# shellcheck disable=SC2086
		curl $OTA_CURL_OPTS -L --fail --show-error --connect-timeout 15 \
			--progress-bar -o "$IMG_PART" "$url" 2>>"$PROG" &
		pid=$!
		echo "$pid" >/var/run/ota/download.pid
		flock -u 300
		if ! wait $pid; then
			ecode=$?
			rm -f /var/run/ota/download.pid
			echo >>"$PROG"
			[ $ecode -eq 143 ] && echo "Canceled!" >>"$PROG"
			rm -f "$IMG_PART"
			return 1
		fi
		rm -f /var/run/ota/download.pid
		echo "Verifying SHA256..." >"$PROG"
		if [ "$(sha256 "$IMG_PART")" != "$sum" ]; then
			echo "Checksum failed!" >>"$PROG"
			rm -f "$IMG_PART"
			return 1
		fi
		mv "$IMG_PART" "$IMG_GZ"
	fi

	echo "Decompressing..." >"$PROG"
	if ! gzip -dc "$IMG_GZ" >"$IMG"; then
		echo "gunzip failed" >>"$PROG"
		rm -f "$IMG"
		return 1
	fi
	# Keep gz for resume; mark done with expected sum (of gz, as in release)
	exec 300>$STLOCK
	flock 300
	echo "$sum" >"$SUMFILE"
	rm -f "$PROG" "$IMG_PART"
	flock -u 300
	# Soft pre-OTA backup after verified download (istoreos-ops). Never fail the download.
	if [ -x /usr/sbin/istoreos-bak ]; then
		/usr/sbin/istoreos-bak backup --reason=ota-download >/tmp/istoreos-bak-ota.out 2>/tmp/istoreos-bak-ota.err \
			|| echo "istoreos-bak soft-fail (disk full?) — OTA download still OK" >>"$STATE_DIR/ota.log"
	fi
	return 0
}

lock_download() {
	exec 200>$WRLOCK
	flock -n 200 || return
	download
	flock -u 200
}

do_download() {
	[ -f "$META" ] || { echo "do check first" >&2; return 254; }
	lock_download &
	return 0
}

# 0 done, 1 downloading, 2 canceled/failed msg, 254 wrong state
do_progress() {
	local sum line
	sum=$(meta_get SHA256 2>/dev/null)
	[ -n "$sum" ] || { echo "do check first" >&2; return 254; }
	[ -f "$SUMFILE" ] && [ "$(cat "$SUMFILE")" = "$sum" ] && [ -f "$IMG" ] && return 0
	[ -f "$PROG" ] || { echo "download not in progress" >&2; return 254; }
	if tail -1 "$PROG" | grep -Fq 'Canceled!'; then
		echo "Canceled"
		return 2
	fi
	if grep -Fq 'Checksum failed!' "$PROG" 2>/dev/null || grep -Fq 'gunzip failed' "$PROG" 2>/dev/null; then
		tr '\r' '\n' <"$PROG" | grep -v '^$' | tail -n1
		return 2
	fi
	# Still downloading or decompressing — keep UI in progress (code 1)
	line=$(tr '\r' '\n' <"$PROG" | grep -v '^$' | tail -n1)
	echo "${line:-Working...}"
	return 1
}

do_progress_locked() {
	local ret
	exec 300>$STLOCK
	flock -s 300
	do_progress
	ret=$?
	flock -u 300
	return $ret
}

do_cancel() {
	if [ -f /var/run/ota/download.pid ]; then
		pid=$(cat /var/run/ota/download.pid)
		if [ -n "$pid" ]; then
			kill -TERM "$pid" 2>/dev/null
			while kill -0 "$pid" >/dev/null 2>&1; do
				sleep 1 || break
			done
		fi
	fi
	return 0
}

usage() {
	echo "usage: ota sub-command"
	echo "  check | download | progress | cancel"
	echo "GitHub OTA: ${owner}/${repo} (*${asset_suffix})"
}

ota_init || exit 255

# Bare "ota" must exit 0 so LuCI menu appears (controller probes this).
case $action in
	"" )
		usage
		exit 0
	;;
	check) do_check ;;
	download) do_download ;;
	progress) do_progress_locked ;;
	cancel) do_cancel ;;
	*)
		usage
		exit 1
	;;
esac
